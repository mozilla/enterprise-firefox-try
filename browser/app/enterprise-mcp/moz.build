RUST_PROGRAMS += ["firefox-enterprise-mcp"]

if CONFIG["OS_ARCH"] == "Darwin":
    LDFLAGS += ["-Wl,-rpath,@executable_path"]

EXPORTS += ["EnterpriseMCPTransport.h"]

XPIDL_MODULE = "enterprise_mcp"
XPIDL_SOURCES += ["nsIEnterpriseMCPTransport.idl"]
XPCOM_MANIFESTS += ["components.conf"]
